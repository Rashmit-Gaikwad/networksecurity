# Copy to .env and fill in the values. .env is gitignored.

# MongoDB that holds the AI.NetworkData collection (local docker container or an Atlas URL)
MONGO_DB_URL=mongodb://localhost:27017/
# app.py reads this name instead of MONGO_DB_URL
MONGODB_URL_KEY=mongodb://localhost:27017/

# MLflow tracking on DagsHub
MLFLOW_TRACKING_URI=https://dagshub.com/Rashmit-Gaikwad/networksecurity.mlflow
MLFLOW_TRACKING_USERNAME=Rashmit-Gaikwad
MLFLOW_TRACKING_PASSWORD=
